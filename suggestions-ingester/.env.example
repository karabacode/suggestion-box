# Copy the OAuth client JSON downloaded from Google Cloud as one line.
GOOGLE_CLIENT_SECRET_JSON='{"web":{"client_id":"...","project_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","client_secret":"...","redirect_uris":["http://localhost:8000/auth/callback"]}}'
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
MAINTENANCE_USERNAME=maintenance
# Required to access /auth/start and /auth/callback.
MAINTENANCE_PASSWORD=replace-with-a-long-random-password
GOOGLE_CLOUD_PROJECT=suggestion-box-508020
# Localhost only: Google permits HTTP localhost callbacks during development.
OAUTHLIB_INSECURE_TRANSPORT=1

# Google Cloud Pub/Sub topic used by Gmail watch notifications.
GOOGLE_PUBSUB_TOPIC=projects/suggestion-box-508020/topics/new-email
SUGGESTION_AGENT_URL=http://localhost:8090
SUGGESTION_AGENT_TOPIC=projects/suggestion-box-508020/topics/analysis-request

# Complete /auth/start once for the Gmail account the service should use.
# Persist the resulting refresh token outside the repository for background use.
# Token JSON from Secret Manager or local environment:
GMAIL_TOKEN_JSON='{"token":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.readonly"]}'
